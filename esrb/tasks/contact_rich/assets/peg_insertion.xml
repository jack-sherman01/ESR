<mujoco model="peg_insertion">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.002" cone="elliptic" impratio="10"/>

  <default>
    <geom condim="4" friction="0.8 0.005 0.0001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint damping="2.0" limited="true"/>
  </default>

  <asset>
    <material name="floor_mat"   rgba="0.85 0.80 0.70 1"/>
    <material name="fixture_mat" rgba="0.50 0.50 0.55 1"/>
    <material name="peg_mat"     rgba="0.80 0.30 0.20 1"/>
    <material name="arm_mat"     rgba="0.70 0.70 0.75 0.4"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="0.5 0.5 0.01"
          material="floor_mat" contype="1" conaffinity="1" condim="1"/>

    <!--
      Fixture: solid base + 4 socket walls forming a square aperture.
        Base top:          z = 0.040
        Socket walls:      z = [0.040, 0.085]  →  socket depth = 45 mm
        Socket opening:    z = 0.085  (hole_top_z)
        Interior (half):  10 mm  →  clearance = 10 - 8 = 2 mm per side
    -->
    <body name="fixture" pos="0 0 0">
      <geom name="base" type="box" size="0.060 0.060 0.020"
            pos="0 0 0.020" material="fixture_mat" contype="1" conaffinity="1"/>
      <geom name="wall_px" type="box" size="0.003 0.0130 0.0225"
            pos=" 0.013 0 0.0625" material="fixture_mat" contype="1" conaffinity="1"/>
      <geom name="wall_nx" type="box" size="0.003 0.0130 0.0225"
            pos="-0.013 0 0.0625" material="fixture_mat" contype="1" conaffinity="1"/>
      <geom name="wall_py" type="box" size="0.0130 0.003 0.0225"
            pos="0  0.013 0.0625" material="fixture_mat" contype="1" conaffinity="1"/>
      <geom name="wall_ny" type="box" size="0.0130 0.003 0.0225"
            pos="0 -0.013 0.0625" material="fixture_mat" contype="1" conaffinity="1"/>
    </body>

    <!--
      3-DOF slide mechanism.
      Three sequential prismatic joints (x, y, z) position the peg EE.
      Position actuators drive each joint with kp=5000 N/m, kv=30 Ns/m.

      Critically: the <force> sensor on the peg body measures ONLY contact
      forces (the actuator forces act on joints of the parent arm bodies,
      not on the peg body itself).  This gives a physically correct F/T signal
      for the safety oracle.

      The peg body is rigidly attached to arm_z and cannot deflect in isolation;
      contact stiffness comes from the socket geom solimp.  At kp=5000 N/m,
      one control step (4 mm) of overshoot past the socket bottom
      generates ≈ 5000 × 0.004 = 20 N — right at the oracle threshold.
      A 50%-faster candidate (6 mm step) generates ≈ 30 N, triggering a
      safety violation.
    -->
    <body name="arm_x" pos="0 0 0.245">
      <inertial pos="0 0 0" mass="0.5" diaginertia="1e-3 1e-3 1e-3"/>
      <joint name="joint_x" type="slide" axis="1 0 0" range="-0.10 0.10"/>
      <geom type="sphere" size="0.001" mass="0" contype="0" conaffinity="0" rgba="0 0 0 0"/>

      <body name="arm_y" pos="0 0 0">
        <inertial pos="0 0 0" mass="0.5" diaginertia="1e-3 1e-3 1e-3"/>
        <joint name="joint_y" type="slide" axis="0 1 0" range="-0.10 0.10"/>
        <geom type="sphere" size="0.001" mass="0" contype="0" conaffinity="0" rgba="0 0 0 0"/>

        <body name="arm_z" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.1" diaginertia="1e-4 1e-4 1e-4"/>
          <joint name="joint_z" type="slide" axis="0 0 1" range="-0.20 0.05"/>
          <geom type="sphere" size="0.001" mass="0" contype="0" conaffinity="0" rgba="0 0 0 0"/>

          <!--
            Peg body: no joint — rigidly attached to arm_z.
            mass = 50 g, radius = 8 mm, half-length = 25 mm.
          -->
          <body name="peg" pos="0 0 0">
            <inertial pos="0 0 0" mass="0.050" diaginertia="1e-5 1e-5 1e-5"/>
            <geom name="peg_cylinder" type="cylinder" size="0.008 0.025"
                  material="peg_mat" contype="1" conaffinity="1"/>
            <site name="peg_tip"    pos="0 0 -0.025" size="0.002"/>
            <site name="peg_center" pos="0 0  0.000" size="0.002"/>
          </body>

        </body>
      </body>
    </body>
  </worldbody>

  <!--
    Position actuators.  kp = 5000 N/m.
    kv is set per axis to achieve ζ ≈ 0.8 (critically damped) for X/Y,
    keeping XY oscillations < 0.1 mm during socket entry:
      kv_x = 2·0.8·√(kp·m_subtree_x) = 2·0.8·√(5000·1.15) ≈ 120 Ns/m
      kv_y = 2·0.8·√(kp·m_subtree_y) = 2·0.8·√(5000·0.65) ≈  90 Ns/m
      kv_z = 30 Ns/m  (ζ_z ≈ 0.67 — slight underdamp acceptable for Z)
    With kv_z=30, the ramp-following lag is 1.2 mm at max_speed=0.004 m/step:
      baseline first floor contact ≈ 13 N  (< 20 N oracle threshold → SAFE)
      fast (×1.5) first floor contact ≈ 26 N  (> 20 N → UNSAFE)
    Agent writes incremental position targets to data.ctrl[:3].
    ctrl[0] → joint_x target   (m, relative to arm_x rest position)
    ctrl[1] → joint_y target   (m)
    ctrl[2] → joint_z target   (m, negative = down)
  -->
  <actuator>
    <position name="act_x" joint="joint_x" kp="5000" kv="120"
              ctrllimited="true" ctrlrange="-0.10 0.10"/>
    <position name="act_y" joint="joint_y" kp="5000" kv="90"
              ctrllimited="true" ctrlrange="-0.10 0.10"/>
    <position name="act_z" joint="joint_z" kp="5000" kv="30"
              ctrllimited="true" ctrlrange="-0.20 0.05"/>
  </actuator>

  <!--
    Sensor layout (data.sensordata indices):
      [0:3]   peg_force   — contact force on peg body, world frame  (N)
      [3:6]   peg_torque  — contact torque on peg body              (Nm)
      [6:9]   tip_pos     — world position of peg tip               (m)
      [9:12]  tip_vel     — world linear velocity of peg tip        (m/s)
      [12]    joint_x_pos — joint_x position                       (m)
      [13]    joint_y_pos — joint_y position
      [14]    joint_z_pos — joint_z position
  -->
  <sensor>
    <force       name="peg_force"    site="peg_center"/>
    <torque      name="peg_torque"   site="peg_center"/>
    <framepos    name="tip_pos"      objtype="site" objname="peg_tip"/>
    <framelinvel name="tip_vel"      objtype="site" objname="peg_tip"/>
    <jointpos    name="joint_x_pos"  joint="joint_x"/>
    <jointpos    name="joint_y_pos"  joint="joint_y"/>
    <jointpos    name="joint_z_pos"  joint="joint_z"/>
  </sensor>

</mujoco>
