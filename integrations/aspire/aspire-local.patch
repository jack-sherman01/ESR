diff --git a/tests/test_libero_adapter_fake.py b/tests/test_libero_adapter_fake.py
index b27750e..43cb62e 100644
--- a/tests/test_libero_adapter_fake.py
+++ b/tests/test_libero_adapter_fake.py
@@ -462,3 +462,15 @@ def test_metadata_extensions_are_allowlisted_and_close_is_idempotent(tmp_path) -
     adapter.close()
     adapter.close()
     assert env.close_calls == 1
+
+
+def test_reset_accepts_numpy_init_state_bank(tmp_path) -> None:
+    """Saved LIBERO states are arrays, whose truth value is ambiguous."""
+    adapter, env, _ = _build_adapter(tmp_path)
+    adapter.registry.init_states = np.asarray(adapter.registry.init_states)
+    try:
+        observation = adapter.reset(("libero_goal_task", 2), seed=2)
+        assert env.selected_init_state == pytest.approx(0.2)
+        np.testing.assert_allclose(observation.robot_state.joint_positions["primary"], 0.2)
+    finally:
+        adapter.close()
